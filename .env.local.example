# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Configuration
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=LACTIVAE <noreply@yourdomain.com>

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rx Web / X-ray
# Development-only bypass: grants a local admin session so X-ray and /admin work
# before Supabase is configured. Has no effect in production builds.
NEXT_PUBLIC_XRAY_DEV_BYPASS=true

# AI-assisted drafting in the Rx Web console (optional)
ANTHROPIC_API_KEY=

# Rebuild the live site when a change is published (Vercel → Settings → Git → Deploy Hooks)
VERCEL_DEPLOY_HOOK_URL=
